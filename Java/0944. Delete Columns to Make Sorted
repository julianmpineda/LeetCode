class Solution {
    public int minDeletionSize(String[] strs) {
        int delete = 0;
        
        for (int i = 0; i < strs[0].length(); i++) {
            int last = strs[0].charAt(i) - 'a';

            for (int j = 1; j < strs.length; j++) {
                int curr = strs[j].charAt(i) - 'a';

                if (curr < last) {
                    delete++;
                    break;
                }
                last = curr;
            }
        } 

        return delete;
    }
}
