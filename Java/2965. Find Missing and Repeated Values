class Solution {
    public int[] findMissingAndRepeatedValues(int[][] grid) {
        int n = grid.length, doubled = 0;
        int[] nums = new int[(n * n) + 1];

        for (int r = 0; r < n; r++) {
            for (int c = 0; c < n; c++) {
                nums[grid[r][c]]++;

                if (nums[grid[r][c]] == 2) {
                    doubled = grid[r][c];
                }
            }
        }

        int missing = 0;

        for (int i = 1; i <= n*n; i++) {
            if (nums[i] == 0) {
                missing = i;
                break;
            }
        }

        return new int[]{doubled, missing};
    }
}
