class Solution {
    public boolean isMiddleElementUnique(int[] nums) {
        int middle = nums.length / 2;
        int mDigit = nums[middle];

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] == mDigit && i != middle) {
                return false;
            }
        }

        return true;
    }
}
