class Solution {
    public int minimumLevels(int[] possible) {
        int sum = 0, len = possible.length;
        int[] pre = new int[len];

        for (int i = 0; i < len; i++) {
            sum += possible[i] == 1 ? 1 : -1;
            pre[i] = sum;   
        }

        for (int j = 0; j < len - 1; j++) {
            int alice = pre[j];
            int bob = sum - pre[j];

            if (alice > bob) {
                return j + 1;
            }
        }

        return -1;
    }
}
