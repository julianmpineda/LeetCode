class Solution {
    public List<List<Integer>> groupThePeople(int[] groupSizes) {
        Map<Integer, List<Integer>> people = new HashMap<>();
        List<List<Integer>> groups = new ArrayList<>();

        // Sort people into group size lists.
        for (int i = 0; i < groupSizes.length; i++) {
            people.putIfAbsent(groupSizes[i], new ArrayList<Integer>());
            people.get(groupSizes[i]).add(i);
        }

        // Iterate through the group sizes.
        for (Integer j : people.keySet()) {
            List<Integer> hold = new ArrayList<>();

            // Break list into properly sized groups
            for (int k = 0; k < people.get(j).size(); k++) {
                hold.add(people.get(j).get(k));
                
                if (hold.size() == j) {
                    groups.add(new ArrayList<>(hold));
                    hold.clear();
                }
            }
        }

        return groups;
    }
}
