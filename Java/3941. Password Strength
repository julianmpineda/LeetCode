class Solution {
    public int passwordStrength(String password) {
        boolean[] used = new boolean[128];
        int score = 0;

        for (char c : password.toCharArray()) {
            if (used[c]) {
                continue;
            }

            if (c >= 'a' && c <= 'z') {
                score++;
            } else if ((c >= 'A' && c <= 'Z')) {
                score += 2;
            } else if ((c >= '0' && c <= '9')) {
                score += 3;
            } else {
                score += 5;
            }

            used[c] = true;
        }

        return score;
    }
}
