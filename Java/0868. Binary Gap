class Solution {
    public int binaryGap(int n) {
        char[] binN = Integer.toBinaryString(n).toCharArray();
        int count = 1, max = 0;

        for (int i = 1; i < binN.length; i++) {
            if (binN[i] == '1') {
                max = Math.max(count, max);
                count = 1;
            } else {
                count++;
            }
        }    
            
        return max;
    }
}
