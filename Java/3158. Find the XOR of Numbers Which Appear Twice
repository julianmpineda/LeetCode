class Solution {
    public int duplicateNumbersXOR(int[] nums) {
        int[] count = new int[51];

        for (int n : nums) {
            count[n]++;
        }

        int twice = 0;

        for (int i = 1; i < 51; i++) {
            if (count[i] == 2) {
                twice ^= i;
            }
        }

        return twice;
    }
}
