class Solution {
    public String reversePrefix(String word, char ch) {
        int end = word.indexOf(ch), start = 0;

        if (end == -1) {
            return word;
        }

        StringBuilder rev = new StringBuilder(word);

        while (start < end) {
            char temp = word.charAt(start);

            rev.setCharAt(start, word.charAt(end));
            rev.setCharAt(end, temp);
            start++;
            end--;
        }

        return rev.toString();
    }
}
