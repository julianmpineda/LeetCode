class Solution {
    public int[][] largestLocal(int[][] grid) {
        int n = grid.length;
        int[][] local = new int[n - 2][n - 2];

        for (int i = 1; i < n - 1; i++) {
            for (int j = 1; j < n - 1; j++) {
                local[i - 1][j - 1] = localMax(grid, i, j);
            }
        }

        return local;
    }

    public int localMax(int grid[][], int i, int j) {
        int max = Math.max(grid[i - 1][j - 1], grid[i - 1][j]);
        max = Math.max(max, grid[i - 1][j + 1]);

        max = Math.max(max, grid[i][j - 1]);
        max = Math.max(max, grid[i][j]);
        max = Math.max(max, grid[i][j + 1]);

        max = Math.max(max, grid[i + 1][j - 1]);
        max = Math.max(max, grid[i + 1][j]);
        max = Math.max(max, grid[i + 1][j + 1]);

        return max;
    }
}
