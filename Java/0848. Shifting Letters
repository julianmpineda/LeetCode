class Solution {
    public String shiftingLetters(String s, int[] shifts) {
        char[] str = s.toCharArray();
        long wrap = 0;

        for (int i = s.length() - 1; i >= 0; i--) {
            wrap += shifts[i];
            char c = (char)(((str[i] - 'a' + wrap) % 26) + 'a');
            str[i] = c;
        }

        return new String(str);
    }
}
