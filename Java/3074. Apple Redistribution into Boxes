class Solution {
    public int minimumBoxes(int[] apple, int[] capacity) {
        int sum = 0;

        for (int a : apple) {
            sum += a;
        }

        Arrays.sort(capacity);

        int boxes = 0, bag = capacity.length - 1;

        while (sum > 0) {
            boxes++;
            sum -= capacity[bag];
            bag--;
        }

        return boxes;
    }
}
