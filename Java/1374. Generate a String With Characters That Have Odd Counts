class Solution {
    public String generateTheString(int n) {
        StringBuilder odd = new StringBuilder();

        for (int i = 0; i < n - 1; i++) {
            odd.append('a');
        }

        if (n % 2 == 0) {
            odd.append('b');
        } else {
            odd.append('a');
        }

        return odd.toString();
    }
}
