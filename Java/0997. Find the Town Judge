class Solution {
    public int findJudge(int n, int[][] trust) {
        int[] people = new int[n + 1];
        int[] trusted = new int[n + 1];
        int sum = 0;

        for (int[] t : trust) {
            // This person trusts someone
            people[t[0]]++;
            // This person is trusted by someone
            trusted[t[1]]++;
        }
    
        for (int i = 1; i <= n; i++) {
            if (people[i] == 0 && trusted[i] == n - 1) {
                return i;
            }
        }

        return -1;
    }
}
