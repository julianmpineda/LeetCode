class Solution {
    public String stringHash(String s, int k) {
        int n = s.length(), pos = 0;
        StringBuilder result = new StringBuilder();

        for (int i = 0; i < (n / k); i++) {
            int sum = 0;

            for (int j = pos; j < pos + k; j++) {
                sum += s.charAt(j) - 'a';
            }
            
            result.append((char)((sum % 26) + 'a'));
            pos += k;
        }

        return result.toString();
    }   
}
