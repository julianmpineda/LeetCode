class Solution {
    public List<List<String>> findMismatchedSegments(String s1, String s2) {
        if(s1.equals(s2)) {
            return new ArrayList<>();
        }

        List<List<String>> subList = new ArrayList<>();
        int start = -1;

        for (int i = 0; i < s1.length(); i++) {
            if (s1.charAt(i) != s2.charAt(i)) {
                if (start == -1) {
                    start = i;
                }
            } else {
                if (start > -1) {
                    List<String> temp = new ArrayList<>();
                    temp.add(s1.substring(start, i));
                    temp.add(s2.substring(start, i));
                    subList.add(temp);
                    start = -1;
                }
            }
        }

        if (start > -1) {
            List<String> temp = new ArrayList<>();
            temp.add(s1.substring(start, s1.length()));
            temp.add(s2.substring(start, s1.length()));
            subList.add(temp);
        }

        return subList;
    }
}
