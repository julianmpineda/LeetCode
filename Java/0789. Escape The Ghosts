class Solution {
    public boolean escapeGhosts(int[][] ghosts, int[] target) {
        int pMoveSum = Math.abs(target[0]) + Math.abs(target[1]);
        
        for (int[] g : ghosts) {
            int gMoveSum = Math.abs(g[0] - target[0]) + Math.abs(g[1] - target[1]);

            if (pMoveSum >= gMoveSum) {
                return false;
            }
        }

        return true;
    }
}
