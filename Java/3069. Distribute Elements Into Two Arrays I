class Solution {
    public int[] resultArray(int[] nums) {
        int[] result = new int[nums.length];
        int[] arr2 = new int[nums.length];
        int l1 = 0, l2 = 0;

        result[0] = nums[0];
        arr2[0] = nums[1];

        for (int i = 2; i < nums.length; i++) {
            if (result[l1] > arr2[l2]) {
                result[++l1] = nums[i];
            } else {
                arr2[++l2] = nums[i];
            }
        }

        l1++;
        l2++;

        for (int j = 0; j < l2; j++) {
            result[l1++] = arr2[j];
        }

        return result;
    }
}
