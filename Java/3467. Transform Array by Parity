class Solution {
    public int[] transformArray(int[] nums) {
        int[] transformed = new int[nums.length];
        int start = 0, end = nums.length - 1;

        for (int n : nums) {
            if (n % 2 == 0) {
                transformed[start] = 0;
                start++;
            } else {
                transformed[end] = 1;
                end--;
            }
        }

        return transformed;
    }
}
