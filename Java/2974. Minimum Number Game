class Solution {
    public int[] numberGame(int[] nums) {
        Queue<Integer> sorted = new PriorityQueue<>();

        for (int n : nums) {
            sorted.offer(n);
        }

        for (int i = 1; i < nums.length; i += 2) {
            nums[i] = sorted.poll();
            nums[i - 1] = sorted.poll();
        }

        return nums;
    }
}

