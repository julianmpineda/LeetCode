class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] shuffled = new int[2*n];
        int count = 0;

        for (int i = 0; i < (2 * n); i++) {
            shuffled[i] = nums[count];
            shuffled[i += 1] = nums[n + count];
            count++;
        }

        return shuffled;
    }
}
