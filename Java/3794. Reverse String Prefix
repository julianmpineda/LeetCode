class Solution {
    public String reversePrefix(String s, int k) {
        StringBuilder rev = new StringBuilder(s);
        int i = 0, j = k - 1;

        while (i < j) {
            char c = s.charAt(i);

            rev.setCharAt(i, s.charAt(j));
            rev.setCharAt(j, c);
            i++;
            j--;
        }

        return rev.toString();
    }
}
