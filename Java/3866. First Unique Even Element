class Solution {
    public int firstUniqueEven(int[] nums) {
        int[] digits = new int[101];

        for (int n : nums) {
            digits[n]++;
        }

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] % 2 == 0 && digits[nums[i]] == 1) {
                return nums[i];
            }
        }

        return -1;
    }
}
