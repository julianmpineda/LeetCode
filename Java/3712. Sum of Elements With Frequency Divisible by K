class Solution {
    public int sumDivisibleByK(int[] nums, int k) {
        int[] count = new int[101];
        int max = 0;

        for (int i = 0; i < nums.length; i++) {
            count[nums[i]]++;
            max = Math.max(max, nums[i]);
        }

        int sum = 0;

        for (int j = 1; j <= max; j++) {
            if (count[j] % k == 0) {
                sum += count[j] * j;
            }
        }

        return sum;
    }
}
