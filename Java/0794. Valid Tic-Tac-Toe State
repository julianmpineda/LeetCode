class Solution {
    public boolean validTicTacToe(String[] board) {
        int x = 0, o = 0;
        boolean xWin = false, oWin = false;;

        // Check rows
        for (String r : board) {
            if (r.equals("XXX")) {
                xWin = true;
            } else if (r.equals("OOO")) {
                oWin = true;
            }

            for (char c : r.toCharArray()) {
                if (c == 'X') {
                    x++;
                } else if (c == 'O') {
                    o++;
                }
            }
        }

        // The turn order/number of 'X' and 'O' is wrong.
        if (x - o > 1 || o > x) {
            return false;
        }

        // Check columns
        for (int i = 0; i < 3; i++) {
            if (board[0].charAt(i) == board[1].charAt(i) 
                && board[1].charAt(i) == board[2].charAt(i)) {

                if (board[0].charAt(i) == 'X') {
                    xWin = true;
                } else if (board[0].charAt(i) == 'O') {
                    oWin = true;
                }
            }
        }

        // Check diagonals
        if (board[0].charAt(0) == board[1].charAt(1) 
            && board[1].charAt(1) == board[2].charAt(2)) {

            if (board[0].charAt(0) == 'X') {
                xWin = true;
            } else if (board[0].charAt(0) == 'O') {
                oWin = true;                
            }
        } else if (board[0].charAt(2) == board[1].charAt(1) 
                && board[1].charAt(1) == board[2].charAt(0)) {

            if (board[0].charAt(2) == 'X') {
                xWin = true;
            } else if (board[0].charAt(2) == 'O') {
                oWin = true;
            }
        }

        // Both win, impossible.
        if (xWin && oWin) {
            return false;
        } 
        
        // Only one wins, but the 'X', 'O' counts are wrong
        if (xWin) {
            if (x == o) {
                return false;
            }
        } else if (oWin) {
            if (x > o) {
                return false;
            }
        }

        return true;
    }
}

