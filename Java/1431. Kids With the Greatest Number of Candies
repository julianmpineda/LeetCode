class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        int max = Integer.MIN_VALUE;

        for (int c : candies) {
            max = Math.max(max, c);
        }

        List<Boolean> greatest = new ArrayList<>();

        for (int i = 0; i < candies.length; i++) {
            greatest.add(candies[i] + extraCandies >= max);
        }

        return greatest;
    }
}
