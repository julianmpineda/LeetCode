class Solution {
    public int[] finalPrices(int[] prices) {
        int len = prices.length;
        int[] discount = new int[len];

        for (int i = 0; i < len; i++) {
            discount[i] = prices[i];
            for (int j = i + 1; j < len; j++) {
                if (prices[j] <= prices[i]) {
                    discount[i] -= prices[j]; 
                    break;
                }
            }
        }

        return discount;
    }
}
