class Solution {

    public List<String> validStrings(int n) {

        List<String> bin = new ArrayList<>();

        if (n == 1) {
            bin.add("0");
            bin.add("1");
            return bin;
        }

        next("0", n, bin);
        next("1", n, bin);

        return bin;
    }

    private static void next(String s, int end, List<String> bin) {
        
        if (s.length() == end) {
            bin.add(s);
            return;
        }

        next(s + '1', end, bin);

        if (s.charAt(s.length() - 1) == '1') {
            next(s + '0', end, bin);   
        }

        return;
    }
}
