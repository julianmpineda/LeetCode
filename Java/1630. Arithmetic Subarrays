class Solution {
    public List<Boolean> checkArithmeticSubarrays(int[] nums, int[] l, int[] r) {
        List<Boolean> result = new ArrayList<>();

        for (int i = 0; i < l.length; i++) {
            int[] n = Arrays.copyOfRange(nums, l[i], r[i] + 1);
            result.add(check(n));
        }

        return result;
    }

    private Boolean check(int[] n) {
        Arrays.sort(n);

        int diff = n[1] - n[0];

        for (int a = 2; a < n.length; a++) {
            if (n[a] - n[a - 1] != diff) {
                return false;
            }
        }

        return true;
    }
}
